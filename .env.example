# JAY Manager OS — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA commitees .env.local (está en .gitignore)

# ─── Supabase ────────────────────────────────────────────────
# Encuéntralas en: https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# ─── Site URL (para callbacks de auth en producción) ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# ─── Google OAuth (Gmail + Calendar) ──────────────────────────
# Crear en https://console.cloud.google.com/apis/credentials
# Ver setup completo en /configuracion → sección Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cifrado en reposo de los tokens OAuth de Gmail (AES-256-GCM). DORMIDO: sin
# esto los tokens se guardan en texto plano (comportamiento actual). Al setearlo
# en Vercel, los tokens nuevos se cifran y las filas legacy se re-cifran solas en
# el próximo refresh. Generar 32 bytes: `openssl rand -hex 32`.
GMAIL_TOKEN_ENC_KEY=

# ─── Database direct connection (solo local, para migrations) ─
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres

# ─── Cron secret (GitHub Actions → /api/gmail/sync-cron) ──────
# Genera con: openssl rand -hex 32
# Pega el MISMO valor en:
#   1. Vercel env vars (Production + Preview)
#   2. GitHub Secret CRON_SECRET (repo settings → Secrets and variables → Actions)
CRON_SECRET=

# Nudge de onboarding incompleto (correo "termina tu perfil" a las +24h).
# DORMIDO por defecto: el cron corre en dry-run (no manda nada, solo lista a
# quién mandaría en /admin/onboarding-nudge). Pon "true" en Vercel cuando
# quieras que empiece a ENVIAR de verdad. Cualquier otro valor = dry-run.
ONBOARDING_NUDGE_ENABLED=

# Digest semanal del pulso de beta (lunes) → correo a quien administra DROP.
# DORMIDO hasta poner la lista de destinatarios (separada por comas). Sin esto
# el cron corre en dry-run (no manda nada). El panel /admin/pulso anda igual.
# Ej: PULSO_DIGEST_TO=jaimeportugueis@gmail.com,fer@...
PULSO_DIGEST_TO=

# ─── Cloudflare Turnstile (CAPTCHA anti-bots) ─────────────────
# DORMIDO sin estas llaves: los forms funcionan igual, sin CAPTCHA.
# Crear widget en https://dash.cloudflare.com → Turnstile (dominio dropgigs.com,
# modo Managed). Para activarlo completo:
#   1. Estas 2 vars en Vercel (Production + Preview)
#   2. El MISMO secret en Supabase → Auth → Attack Protection →
#      Enable CAPTCHA → Turnstile (protege login/signup/reset)
# ⚠️ GOTCHA: en Vercel, NO marques NEXT_PUBLIC_TURNSTILE_SITE_KEY como
# "Sensitive". Las vars NEXT_PUBLIC_ se "hornean" en el bundle del cliente
# DURANTE el build, y una var Sensitive está oculta para el build → llega vacía
# y el CAPTCHA nunca aparece. El SECRET sí va Sensitive (se lee en runtime).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Sentry (monitoreo de errores en vivo) ───────────────────
# DORMIDO sin estas vars: no se inicializa, build idéntico, cero overhead.
# Activar:
#   1. Cuenta gratis en https://sentry.io → New Project → Next.js → "dropgigs"
#   2. Copiar el DSN que te da y pegarlo en Vercel (Production + Preview) en
#      AMBAS vars (mismo valor) → redeploy:
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Opcional pero MUY recomendado — stack traces LEGIBLES (source maps). Sin
# esto los errores de prod salen minificados (`sN`/`iz`, `<script>:1:…`) e
# imposibles de diagnosticar. Ya está cableado en next.config.mjs; solo faltan:
#   3. Sentry → Settings → Auth Tokens → crear token con scope `project:releases`
#      (+ `org:read`). Pegar las 3 vars en Vercel (Production + Preview) → redeploy.
#      Con SENTRY_AUTH_TOKEN presente, `next build` sube los source maps solo.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=dropgigs

# ─── DROP AI Council (revisor ChatGPT vía OpenAI) ─────────────
# Solo se usa al ejecutar /product-council. La app DROP no depende de esto.
# La llave se lee desde .env.local (local, en .gitignore); NUNCA se commitea ni
# se imprime, y el sanitizador la redacta antes de cualquier envío.
#   1. Crear la llave en https://platform.openai.com/api-keys
#   2. Pegarla en .env.local (NO aquí). Dejar este archivo con el placeholder.
OPENAI_API_KEY=
# Modelo de OpenAI a usar como revisor. NO hay default hardcodeado: hay que
# elegirlo (ej. gpt-4.1, gpt-4.1-mini, o el que prefieras que soporte
# Structured Outputs). Sin este valor, /product-council avisa y no llama a la API.
OPENAI_MODEL=
# Máximo de rondas del debate (el spec fija el tope en 3; se puede bajar).
AI_COUNCIL_MAX_ROUNDS=3
# Timeout por llamada a OpenAI, en ms.
AI_COUNCIL_TIMEOUT_MS=120000
# Reintentos ante errores transitorios (429/5xx/timeout).
AI_COUNCIL_MAX_RETRIES=2

# --- Spotify (Redes: sync de followers + popularity del artista) ---
# App en https://developer.spotify.com/dashboard (gratis, sin review). Sin estas 2, Spotify queda deshabilitado.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Instagram / Meta (Redes: sync de followers vía Business Discovery) ---
# Requiere app de Meta + cuenta IG Business de DROP linkeada a una FB Page + APP REVIEW de Meta
# (permisos instagram_basic + pages_read_engagement + verificación de negocio). Sin review solo anda en modo dev.
META_GRAPH_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Transición de marca "Reinventándonos" (landing teaser) ---
# DROP_TEASER=1 oculta la app pública y muestra la landing teaser en "/".
# Todo lo demás (páginas públicas y privadas) redirige 307 a "/". Siguen vivos:
# /api (webhooks+crons), /auth, sitemap/robots, sw/manifest y estáticos.
# Rollback = poner 0 o quitar la variable (o Instant Rollback en Vercel).
DROP_TEASER=0
# Puerta privada del equipo: con el teaser on, /?unlock=<este_valor> setea una
# cookie y ese navegador ve la app real (para QA en prod). Deja vacío para no
# habilitar bypass. Usa un valor largo y secreto (NO lo compartas en links).
DROP_TEASER_UNLOCK=
